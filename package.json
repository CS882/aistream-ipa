{
  "name": "aistream-multiplatform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AIStream 影视 · 四端（桌面 / iOS / 安卓 / TV）统一业务内核 + 独立适配界面",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "tv": "node server.js",
    "check": "node scripts/check.mjs",
    "desktop": "electron .",
    "sync:assets": "node scripts/sync-web-assets.mjs",
    "dist:win": "npm run sync:assets && electron-builder --win --x64",
    "dist:android": "npm run sync:assets && python scripts/build-apk.py android",
    "dist:tv": "npm run sync:assets && python scripts/build-apk.py android-tv",
    "build:all": "npm run sync:assets && electron-builder --win --x64 && python scripts/build-apk.py",
    "build:ipa": "bash ios/build-ipa.sh"
  },
  "build": {
    "productName": "AIStream 影视",
    "directories": {
      "output": "dist-win-feat",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "desktop.html",
      "mobile.html",
      "tv.html",
      "sw.js",
      "src/**/*",
      "public/**/*",
      "electron-main.cjs",
      "server.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AIStream-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIStream 影视"
    },
    "portable": {
      "artifactName": "AIStream-Portable-${version}.${ext}"
    }
  },
  "keywords": [
    "AIStream",
    "影视",
    "桌面",
    "iOS",
    "安卓",
    "TV",
    "四端"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "comment": "核心运行零依赖。electron / @capacitor/* 为可选原生打包工具，安装方式见 docs/03-各端运行说明.md，未安装不影响 npm start 与四端浏览器入口。",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}